generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id          String      @id @default(cuid())
  name        String
  contactInfo String?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  portfolios  Portfolio[]
}

model Portfolio {
  id              String                    @id @default(cuid())
  memberId        String
  member          Member                    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  name            String
  type            String                    @default("demat")
  currency        String                    @default("INR")
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  trades          Trade[]
  lots            Lot[]
  realizedGains   RealizedGain[]
  valueSnapshots  PortfolioValueSnapshot[]
  tradeAudits     TradeAuditLog[]
  cashTransactions CashTransaction[]
  realizedPlAdjustments RealizedPlAdjustment[]
}

model CashTransaction {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /** DEPOSIT | WITHDRAWAL */
  type        String
  /** Always positive */
  amount      Float
  executedAt  DateTime
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([portfolioId, executedAt])
}

/**
 * Opening / manual booked P&L (e.g. profits realized before Market Edge).
 * Counts toward realized P&L display only — does not change cash or invent trades.
 * Excluded from in-app tax estimates by default.
 */
model RealizedPlAdjustment {
  id          String    @id @default(cuid())
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /** Signed: profit > 0, loss < 0 */
  amount      Float
  /** When the P&L was booked (broker / prior system) */
  bookedAt    DateTime
  /** Optional label, e.g. ticker or "PRIOR" */
  label       String?
  /** STCG | LTCG | OTHER — OTHER is performance-only */
  term        String    @default("OTHER")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([portfolioId, bookedAt])
}

model Trade {
  id             String          @id @default(cuid())
  portfolioId    String
  portfolio      Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker         String
  action         String // BUY | SELL
  instrumentType String          @default("EQUITY") // EQUITY | FUTURES
  quantity       Float
  /** Shares per lot for futures (1 for equity). From Fyers FO master when known. */
  lotSize        Float           @default(1)
  /** Total margin blocked for this trade (futures). Released pro-rata on close. */
  margin         Float           @default(0)
  pricePerShare  Float
  fees           Float           @default(0)
  executedAt     DateTime
  notes          String?
  deletedAt      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  openLots       Lot[]           @relation("OpenTrade")
  closedGains    RealizedGain[]  @relation("CloseTrade")
  audits         TradeAuditLog[]

  @@index([portfolioId, ticker])
  @@index([executedAt])
}

model TradeAuditLog {
  id          String    @id @default(cuid())
  tradeId     String?
  trade       Trade?    @relation(fields: [tradeId], references: [id], onDelete: SetNull)
  portfolioId String
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  action      String // CREATE | UPDATE | SOFT_DELETE | RESTORE
  snapshot    String // JSON of trade state
  createdAt   DateTime  @default(now())
}

model Lot {
  id                 String         @id @default(cuid())
  portfolioId        String
  portfolio          Portfolio      @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker             String
  openTradeId        String
  openTrade          Trade          @relation("OpenTrade", fields: [openTradeId], references: [id])
  quantityRemaining  Float
  costBasisPerShare  Float
  /** Futures margin still blocked for this open lot (released on close). */
  marginRemaining    Float          @default(0)
  acquiredAt         DateTime
  createdAt          DateTime       @default(now())
  realizedGains      RealizedGain[]

  @@index([portfolioId, ticker])
}

model RealizedGain {
  id            String    @id @default(cuid())
  portfolioId   String
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker        String
  lotId         String
  lot           Lot       @relation(fields: [lotId], references: [id])
  closeTradeId  String
  closeTrade    Trade     @relation("CloseTrade", fields: [closeTradeId], references: [id])
  quantity      Float
  proceeds      Float
  costBasis     Float
  gainLoss      Float
  term          String // STCG | LTCG
  financialYear String
  closedAt      DateTime
  createdAt     DateTime  @default(now())

  @@index([portfolioId, financialYear])
  @@index([term])
}

model TaxSettings {
  id                        String   @id @default(cuid())
  jurisdiction              String   @default("IN")
  stcgRatePct               Float    @default(20)
  ltcgRatePct               Float    @default(12.5)
  ltcgExemptionAmountPerFY  Float    @default(125000)
  longTermThresholdDays     Int      @default(365)
  effectiveFrom             DateTime @default(now())
  createdAt                 DateTime @default(now())
}

model PriceSnapshot {
  ticker        String   @id
  price         Float
  dayChange     Float    @default(0)
  dayChangePct  Float    @default(0)
  currency      String   @default("INR")
  fetchedAt     DateTime
  stale         Boolean  @default(false)
}

model PortfolioValueSnapshot {
  id             String    @id @default(cuid())
  portfolioId    String
  portfolio      Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  date           DateTime
  totalValue     Float
  totalCostBasis Float
  realizedPl     Float     @default(0)

  @@unique([portfolioId, date])
  @@index([portfolioId, date])
}

model TechnicalInsight {
  id          String   @id @default(cuid())
  ticker      String
  timeframe   String // DAILY | WEEKLY
  levels      String // JSON
  aiNarrative String?
  generatedAt DateTime

  @@unique([ticker, timeframe])
}
